# ==============================================================================
# LEED - Global Lead Intelligence & Sales Automation Platform
# Production Configuration (.env)
# ==============================================================================

# 1. Server & Environment
PORT=3000
NODE_ENV="production"
APP_URL="http://localhost:3000"

# 2. Relational PostgreSQL Database
# Primary persistence store for the approved 12-table architecture.
# When absent or disconnected, LEED gracefully uses verified JSON fallback.
DATABASE_URL="postgresql://postgres:password@localhost:5432/leed_db?sslmode=prefer"
PGSSLMODE="prefer"

# 3. Security & Session Secrets
# Cryptographic salts and tokens for private owner session signing.
SESSION_SECRET="replace-with-a-64-character-cryptographically-strong-secret"
COOKIE_SECRET="replace-with-a-64-character-cryptographically-strong-secret"

# 4. External Data Connectors & APIs
# UK Companies House API Key (Free registration at https://developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=""

# Google GenAI API Key for Sales Assistant, Market Briefs & Pitch Generation
GEMINI_API_KEY=""
